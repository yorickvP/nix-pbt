# Same as evaluators.env, but one process per expression (slow, simplest).
export NIX_PBT_EVALUATORS="\
cppnix=$PWD/../nix/result/bin/nix-instantiate --eval --strict --json --extra-experimental-features 'nix-command flakes' -E;\
lix=$PWD/result-lix/bin/nix-instantiate --eval --strict --json --extra-experimental-features 'nix-command flakes' -E;\
fix=$PWD/result-fix/bin/fix eval --strict --json --extra-experimental-features 'flakes fetch-tree' -E"
