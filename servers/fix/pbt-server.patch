+++ b/src/cli/repl/pbt_server.zig
@@ -0,0 +1,72 @@
+//! `fix repl --pbt-server`: serve the nix-pbt evaluation protocol on
+//! stdin/stdout instead of a REPL.
+//!
+//!   request:  <byte length>\n<expression>
+//!   response: ok <byte length>\n<JSON value>
+//!          |  error <byte length>\n<error message>
+//!
+//! Each expression is evaluated like `fix eval --read-write-mode --strict
+//! --json -E`: relative paths resolve against the working directory, and
+//! nothing is bound between requests. See https://github.com/yorickvP/nix-pbt.
+
+const std = @import("std");
+const engine = @import("expr");
+const render = @import("../render.zig");
+
+const Engine = engine.Engine;
+
+/// Reclaim the previous requests' garbage every this many requests. The repl
+/// collects after every input, which dominates the cost of tiny ones.
+const collect_every = 64;
+
+pub fn run(allocator: std.mem.Allocator, io: std.Io, ev: *Engine, show_trace: bool) !void {
+    // One daemon connection instead of a pool of 8 per process: requests are
+    // served one at a time, and test suites run many servers at once.
+    ev.store.daemon_runtime.pool_workers = 1;
+    // Like `nix repl` (and the CppNix server): derivations and sources are
+    // written to the store, so their paths are the real ones.
+    ev.setParallelismToggles(true, true);
+    ev.enableReadWriteEvaluation();
+
+    var stdin_buffer: [64 * 1024]u8 = undefined;
+    var stdin = std.Io.File.stdin().readerStreaming(io, &stdin_buffer);
+    var stdout_buffer: [64 * 1024]u8 = undefined;
+    var stdout = std.Io.File.stdout().writerStreaming(io, &stdout_buffer);
+
+    var body: std.Io.Writer.Allocating = .init(allocator);
+    defer body.deinit();
+    var served: usize = 0;
+    while (try stdin.interface.takeDelimiter('\n')) |header| {
+        const len = std.fmt.parseInt(usize, header, 10) catch return error.BadRequest;
+        const source = try allocator.alloc(u8, len);
+        defer allocator.free(source);
+        try stdin.interface.readSliceAll(source);
+
+        body.clearRetainingCapacity();
+        const ok = evaluate(ev, &body, source, show_trace);
+        try stdout.interface.print("{s} {d}\n", .{ if (ok) "ok" else "error", body.written().len });
+        try stdout.interface.writeAll(body.written());
+        try stdout.interface.flush();
+
+        served += 1;
+        if (served % collect_every == 0) _ = ev.collectMajorNow();
+    }
+}
+
+/// Write the strict value as JSON to `out`, or the error report if that
+/// fails. Returns whether it succeeded.
+fn evaluate(ev: *Engine, out: *std.Io.Writer.Allocating, source: []const u8, show_trace: bool) bool {
+    const value = ev.evaluate(source) catch |err| {
+        render.evalFailureTo(&out.writer, false, show_trace, ev, source, err) catch {};
+        return false;
+    };
+    const err = blk: {
+        ev.forceDeep(value) catch |err| break :blk err;
+        ev.writeJsonValue(&out.writer, value) catch |err| break :blk err;
+        return true;
+    };
+    // Drop any partially written JSON.
+    out.clearRetainingCapacity();
+    render.evaluationErrorTo(&out.writer, false, show_trace, ev, source, err) catch {};
+    return false;
+}
