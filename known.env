# Source this after evaluators.env to skip every known divergence between
# CppNix main, Lix main and fix main (see the tag table in the README), so
# that a run only reports new ones.
export NIX_PBT_SKIP=circular-import,lock-no-check,override-follows,override-original,root-input-hash,empty-list-laziness,convert-hash,error-order,context-compare,no-context,lax-types,function-equality,fetchtree-revcount,tarball-top-level,fetch-path-name,tarball-last-modified,git-dirty-rev,git-stale-mount,store-write-desync,failed-copy-crash,versions,float-to-int-range,subnormal-literals,to-string-float,drv-validation,drv-unparsable,drv-output-split,output-hash,drvpath-output,hash-mode-nar,blake3,relative-inputs,flake-subdir,fetchtree-url-shallow,drv-output-name,context-nonexistent,split-context,parse-drv-name,flakeref,read-only-outpath,read-only-names,path-lexing,toxml-primop,regex,throw-coercion,number-select,tojson-outpath,foldl-thunk,canonpath-signed-char,generic-closure-operator,lock-node-names
