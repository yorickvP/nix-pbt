# Source this to compare CppNix (../nix), Lix (system) and fix using
# long-lived sessions. CppNix comes first: it's the reference the others are
# compared against. Build its server first:
#   nix-build -A server-capi --arg nixFlake ../nix -o result-server-capi
#
# fix runs with --workers 1: its parallel evaluator makes tiny evaluations
# ~3x slower and oversubscribes the CPU when many tests run at once. Drop
# the flag to test the parallel evaluator.
export NIX_PBT_EVALUATORS="\
cppnix=server:$PWD/result-server-capi/bin/nix-pbt-server-capi --option extra-experimental-features flakes --option substituters '';\
lix=repl:nix repl --extra-experimental-features 'nix-command flakes' --option substituters '';\
fix=repl:$PWD/result-fix/bin/fix repl --json --no-color --workers 1 --extra-experimental-features 'flakes fetch-tree'"

# Commands that lock the flake in the current directory, for
# tests/flakes.rs:lock_files_are_interchangeable.
export NIX_PBT_FLAKE_LOCK="\
cppnix=$PWD/../nix/result/bin/nix flake lock --extra-experimental-features 'nix-command flakes';\
lix=nix flake lock --extra-experimental-features 'nix-command flakes';\
fix=$PWD/result-fix/bin/fix flake lock --extra-experimental-features 'flakes fetch-tree'"
