# Source this to compare CppNix (../nix), Lix and fix using long-lived
# sessions. CppNix comes first: it's the reference the others are compared
# against. Build them first:
#   nix-build -A server-capi --arg nixFlake ../nix -o result-server-capi
#   nix-build -A fix -o result-fix       # fix main, patched with --pbt-server
#   nix build git+https://git.lix.systems/lix-project/lix -o result-lix
#
# fix runs three ways: read-write with one worker (`fix`), read-write with
# its parallel evaluator (`fixpar`; speculation included), and read-only
# (`fixro`, like plain `fix eval`), which should give the same results.
fix="$PWD/result-fix/bin/fix repl --pbt-server --no-color --extra-experimental-features 'flakes fetch-tree'"
export NIX_PBT_EVALUATORS="\
cppnix=server:$PWD/result-server-capi/bin/nix-pbt-server-capi --option extra-experimental-features flakes --option substituters '';\
lix=repl:$PWD/result-lix/bin/nix repl --extra-experimental-features 'nix-command flakes' --option substituters '';\
fix=server:$fix --read-write-mode --workers 1;\
fixpar=server:$fix --read-write-mode --workers 4;\
fixro=server:$fix --workers 1"
unset fix

# Commands that lock the flake in the current directory, for
# tests/flakes.rs:lock_files_are_interchangeable.
export NIX_PBT_FLAKE_LOCK="\
cppnix=$PWD/../nix/result/bin/nix flake lock --extra-experimental-features 'nix-command flakes';\
lix=$PWD/result-lix/bin/nix flake lock --extra-experimental-features 'nix-command flakes';\
fix=$PWD/result-fix/bin/fix flake lock --extra-experimental-features 'flakes fetch-tree'"
