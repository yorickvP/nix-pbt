# Source this after evaluators.env to skip every known divergence between
# CppNix main, Lix main and fix main (see the tag table in the README), so
# that a run only reports new ones.
export NIX_PBT_SKIP=circular-import,lock-no-check,override-follows,override-original,root-input-hash,empty-list-laziness,convert-hash,error-order,context-compare,no-context,lax-types,function-equality,fetchtree-revcount,tarball-top-level,fetch-path-name,tarball-last-modified,git-dirty-rev,git-stale-mount,store-write-desync,failed-copy-crash,versions
